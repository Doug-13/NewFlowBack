  documents_document_relations_parent_document_idTodocuments                            documents          @relation("document_relations_parent_document_idTodocuments", fields: [parent_document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_relations_parent_document")
  document_instances_document_relations_parent_document_instance_idTodocument_instances document_instances @relation("document_relations_parent_document_instance_idTodocument_instances", fields: [parent_document_instance_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_relations_parent_instance")

  @@index([account_id], map: "idx_document_relations_account_id")
  @@index([child_document_id], map: "idx_document_relations_child_document_id")
  @@index([child_document_instance_id], map: "idx_document_relations_child_instance_id")
  @@index([parent_document_id], map: "idx_document_relations_parent_document_id")
  @@index([parent_document_instance_id, relation_group_id, wait_for_completion, status], map: "idx_document_relations_parent_group_wait")
  @@index([parent_document_instance_id], map: "idx_document_relations_parent_instance_id")
  @@index([relation_group_id], map: "idx_document_relations_relation_group_id")
  @@index([source_table_metadata_definition_id], map: "idx_document_relations_source_table")
  @@index([child_document_instance_id, wait_for_completion, status], map: "idx_document_relations_waiting_child")
}

