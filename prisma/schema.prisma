  document_type_id         String?                    @db.VarChar(100)
  document_type_name       String?                    @db.VarChar(200)
  bpmn_xml                 String                     @default("")
  steps_count              Int                        @default(0)
  permissions              Json                       @default("{\"creation\": {\"areaIds\": [], \"roleIds\": [], \"unitIds\": [], \"userIds\": [], \"groupIds\": [], \"processIds\": [], \"disciplineIds\": [], \"environmentIds\": []}, \"visualization\": {\"areaIds\": [], \"roleIds\": [], \"unitIds\": [], \"userIds\": [], \"groupIds\": [], \"processIds\": [], \"disciplineIds\": [], \"environmentIds\": []}}")
  element_configs          Json                       @default("[]")
  snapshots                Json                       @default("[]")
  scope_level              String                     @default("process") @db.VarChar(20)
