generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id         String   @id
  name       String
  code       String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model audit_logs {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_instance_id String             @db.Uuid
  action               String             @db.VarChar(120)
  step_name            String?            @db.VarChar(180)
  user_name            String?            @db.VarChar(180)
  comment              String?
  metadata             Json?
  created_at           DateTime           @default(now()) @db.Timestamp(6)
  updated_at           DateTime           @default(now()) @db.Timestamp(6)
  document_instances   document_instances @relation(fields: [document_instance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([document_instance_id, created_at(sort: Desc)], map: "idx_audit_logs_document_created_at")
  @@index([document_instance_id], map: "idx_audit_logs_document_instance")
  @@index([document_instance_id], map: "idx_audit_logs_document_instance_id")
}

model document_action_history {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_instance_id  String   @db.Uuid
  step_name             String?  @db.VarChar(255)
  step_order_index      Int?
  element_id            String?  @db.VarChar(255)
  action_id             String   @db.VarChar(255)
  outcome               String?  @db.VarChar(255)
  comment               String?
  executed_by_user_id   String?  @db.VarChar(255)
  executed_by_user_name String?  @db.VarChar(255)
  executed_at           DateTime @default(now()) @db.Timestamp(6)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @default(now()) @db.Timestamp(6)

  @@index([document_instance_id], map: "idx_dah_document_instance_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model document_instances {
  id                                                                                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id                                                                            String                  @db.VarChar(100)
  process_id                                                                            String                  @db.VarChar(100)
  process_name                                                                          String?                 @db.VarChar(180)
  title                                                                                 String                  @db.VarChar(255)
  code                                                                                  String                  @db.VarChar(60)
  revision                                                                              String                  @default("00") @db.VarChar(10)
  parent_document_id                                                                    String?                 @db.Uuid
  status                                                                                String                  @default("draft") @db.VarChar(30)
  workflow_id                                                                           String                  @db.VarChar(100)
  workflow_name                                                                         String?                 @db.VarChar(180)
  current_step_name                                                                     String?                 @db.VarChar(180)
  current_step_order_index                                                              Int?
  responsible_id                                                                        String?                 @db.VarChar(100)
  responsible_name                                                                      String?                 @db.VarChar(180)
  created_by_id                                                                         String                  @db.VarChar(100)
  created_by_name                                                                       String?                 @db.VarChar(180)
  due_date                                                                              DateTime?               @db.Timestamp(6)
  created_at                                                                            DateTime                @default(now()) @db.Timestamp(6)
  updated_at                                                                            DateTime                @default(now()) @db.Timestamp(6)
  current_element_id                                                                    String?
  current_assigned_user_id                                                              String?
  current_assigned_user_name                                                            String?
  allowed_actions                                                                       Json                    @default("[]")
  task_actions                                                                          Json                    @default("[]")
  document_id                                                                           String                  @db.Uuid
  audit_logs                                                                            audit_logs[]
  documents_document_instances_document_idTodocuments                                   documents               @relation("document_instances_document_idTodocuments", fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  document_instances                                                                    document_instances?     @relation("document_instancesTodocument_instances", fields: [parent_document_id], references: [id], onUpdate: NoAction)
  other_document_instances                                                              document_instances[]    @relation("document_instancesTodocument_instances")
  document_relations_document_relations_child_document_instance_idTodocument_instances  document_relations[]    @relation("document_relations_child_document_instance_idTodocument_instances")
  document_relations_document_relations_parent_document_instance_idTodocument_instances document_relations[]    @relation("document_relations_parent_document_instance_idTodocument_instances")
  documents_documents_current_instance_idTodocument_instances                           documents[]             @relation("documents_current_instance_idTodocument_instances")
  metadata_value_tables                                                                 metadata_value_tables[]
  metadata_values                                                                       metadata_values[]
  tasks                                                                                 tasks[]

  @@unique([document_id, revision], map: "document_instances_document_revision_key")
  @@index([document_id], map: "idx_di_document_id")
  @@index([document_id, revision(sort: Desc)], map: "idx_di_document_id_revision")
  @@index([account_id, process_id], map: "idx_document_instances_account_process")
  @@index([account_id, status], map: "idx_document_instances_account_status")
  @@index([created_by_id], map: "idx_document_instances_created_by")
  @@index([current_assigned_user_id], map: "idx_document_instances_current_assigned_user_id")
  @@index([current_element_id], map: "idx_document_instances_current_element_id")
  @@index([parent_document_id], map: "idx_document_instances_parent")
  @@index([workflow_id, current_step_order_index], map: "idx_document_instances_workflow_step")
}

